#!/bin/sh
# podkop server-updater.
# Метод записи определяется ПО ФОРМАТУ конфига (а не по модели):
#   • config main 'main'    -> наш бэкпорт (Xiaomi Gigabit v1/v2) -> запись через UCI
#   • config section 'main' -> новый podkop (все прочие)          -> оригинальный awk
#
# Лимит серверов вешается ПО ЖЕЛЕЗУ:
#   • ЛЮБОЙ MT7621 (DIR-2150, Xiaomi 4A/4 Gigabit v1/v2, Mi Router 4,
#     Xiaomi/Redmi AC2100 и т.д.) -> 50 серверов.
#     На MT7621 (128/256 МБ) конфиг sing-box на 100+ аутбаундов с fakeip
#     собирается минутами и захлёбывается, поэтому жёсткий потолок 50.
#   • прочее заведомо слабое, не MT7621 -> 100 (fallback по имени модели).
#   • всё остальное -> без лимита.
#
# Использование:  sh update.sh [restart]
COMMAND="$1"
CONFIG="/etc/config/podkop"
VLESS_URL="https://gist.githubusercontent.com/perspekt1va/1b7807389ed25f0fbbde02886f4fd1d9/raw/subscription"

# Потолок для MT7621 и fallback для прочего слабого железа
MT7621_LIMIT=50
WEAK_PATTERN='mi router 4|ac2100|dir-2150|xiaomi.*gigabit|redmi.*(ac2100|gigabit)'
WEAK_LIMIT=100

log() { echo "[$(date '+%F %T')] $*"; }

restart_target() {
  if [ -x /etc/init.d/podkop ]; then
    /etc/init.d/podkop restart && log "podkop: restart OK" && return 0
  fi
  if [ -x /etc/init.d/sing-box ]; then
    /etc/init.d/sing-box reload 2>/dev/null && { log "sing-box: reload OK"; return 0; }
    /etc/init.d/sing-box restart && log "sing-box: restart OK"; return 0
  fi
  log "Не нашёл init-скрипты podkop/sing-box — рестарт пропущен."
}

get_model() {
  if [ -r /tmp/sysinfo/model ]; then cat /tmp/sysinfo/model
  elif command -v ubus >/dev/null 2>&1; then
    ubus call system board 2>/dev/null | grep -o '"model"[^,]*' | head -n1 | sed 's/.*: *"//; s/".*//'
  elif [ -r /proc/device-tree/model ]; then tr -d '\0' < /proc/device-tree/model
  fi
}

# Надёжное определение SoC MT7621: сперва по железу (cpuinfo / device-tree),
# затем — как запасной вариант — по имени модели.
is_mt7621() {
  if grep -qiE 'mt7621|mediatek[^0-9]*7621' /proc/cpuinfo 2>/dev/null; then
    return 0
  fi
  if [ -r /proc/device-tree/compatible ]; then
    if tr '\0' '\n' < /proc/device-tree/compatible 2>/dev/null | grep -qi '7621'; then
      return 0
    fi
  fi
  if command -v ubus >/dev/null 2>&1; then
    if ubus call system board 2>/dev/null | grep -qi '7621'; then
      return 0
    fi
  fi
  # fallback по имени модели (известные MT7621-устройства)
  echo "$MODEL" | grep -iqE 'mt7621|gigabit|dir-2150|ac2100|mi router 4[^cq]|redmi.*(ac2100|ax6|gigabit)' && return 0
  return 1
}

fetch() {
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL --connect-timeout 8 --max-time 30 -A "KyKyIIIKuHVless" "$1" 2>/dev/null && return 0
  fi
  if command -v uclient-fetch >/dev/null 2>&1; then
    uclient-fetch -qO- --timeout=20 "$1" 2>/dev/null && return 0
  fi
  wget --no-check-certificate --user-agent="KyKyIIIKuHVless" -qO- "$1" 2>/dev/null
}

MODEL=$(get_model)
log "Модель роутера: ${MODEL:-неизвестно}"

# ── чек-ин: отметить роутер в реестре (соль = CHECKIN_SALT в backup-updater) ──
if [ -x /etc/vpn-checkin.sh ]; then
  /etc/vpn-checkin.sh update >/dev/null 2>&1 &
else
  (
    SALT="0bef701db5c71acd"
    mac=$(cat /sys/class/net/eth0/address 2>/dev/null)
    [ -n "$mac" ] || mac=$(cat /sys/class/net/br-lan/address 2>/dev/null)
    if [ -n "$mac" ]; then
      if command -v sha256sum >/dev/null 2>&1; then
        id=$(printf '%s' "$mac$SALT" | sha256sum | cut -c1-12)
      else
        id=$(printf '%s' "$mac$SALT" | md5sum | cut -c1-12)
      fi
      mdl=$(printf '%s' "$MODEL" | sed 's/ /%20/g; s/&/%26/g; s/#/%23/g')
      sub=0; grep -q "proxy_config_type 'subscription'" /etc/config/podkop 2>/dev/null && sub=1
      U="https://vhodniegruppi.online/gw/checkin?id=$id&mac=$mac&model=$mdl&sub=$sub&src=update"
      if command -v curl >/dev/null 2>&1; then curl -fsS -m 15 -o /dev/null "$U"
      else wget -q -T 15 -O /dev/null "$U"; fi
    fi
  ) >/dev/null 2>&1 &
fi

# ── формат конфига (метод записи) ───────────────────────────────────────
if grep -q "^config main 'main'" "$CONFIG" 2>/dev/null; then
  FORMAT="old"   # наш бэкпорт: config main 'main'
else
  FORMAT="new"   # новый podkop: config section 'main'
fi
log "Формат конфига: $FORMAT"

# ── режим «Подписка»: сервера приходят по ссылке подписки, gist не трогаем ──
if [ "$(uci -q get podkop.main.proxy_config_type)" = "subscription" ]; then
  log "Режим «Подписка» — обновляю по ссылке подписки, gist не использую."
  /usr/bin/podkop subscription_update >/dev/null 2>&1 || true
  echo "Режим подписки: сервера обновлены по вашей ссылке подписки"
  echo "Сервера обновлены"
  exit 0
fi

# ── лимит по железу ─────────────────────────────────────────────────────
LIMIT=0
if is_mt7621; then
  LIMIT="$MT7621_LIMIT"
  log "SoC MT7621 — лимит $LIMIT серверов (слабое железо, fakeip)."
elif [ -n "$MODEL" ] && echo "$MODEL" | grep -iqE "$WEAK_PATTERN"; then
  LIMIT="$WEAK_LIMIT"
  log "Слабая модель (не MT7621) — лимит $LIMIT серверов."
fi

# ── получить список VLESS ───────────────────────────────────────────────
RAW=$(fetch "$VLESS_URL")
VLESS_LIST=$(printf '%s' "$RAW" | base64 -d 2>/dev/null | grep 'vless://' | grep -v 'xhttp')
if [ -z "$VLESS_LIST" ]; then
  echo "✗ Не удалось получить VLESS список (проверьте доступ к подписке)"
  exit 1
fi
TOTAL=$(printf '%s\n' "$VLESS_LIST" | grep -c 'vless://')
if [ "$LIMIT" -gt 0 ] && [ "$TOTAL" -gt "$LIMIT" ]; then
  VLESS_LIST=$(printf '%s\n' "$VLESS_LIST" | head -n "$LIMIT")
  WRITTEN="$LIMIT"
  log "Доступно $TOTAL, записано $LIMIT (лимит железа)."
else
  WRITTEN="$TOTAL"
  log "Доступно $TOTAL, записано все."
fi

# ── запись по формату ───────────────────────────────────────────────────
if [ "$FORMAT" = "old" ]; then
  # Xiaomi Gigabit v1/v2 (наш бэкпорт) — через UCI
  uci -q delete podkop.main.urltest_proxy_links
  TMP="/tmp/podkop_vless_$$"
  printf '%s\n' "$VLESS_LIST" > "$TMP"
  while IFS= read -r link; do
    [ -n "$link" ] && uci add_list podkop.main.urltest_proxy_links="$link"
  done < "$TMP"
  rm -f "$TMP"
  uci -q set podkop.main.proxy_config_type='urltest'
  uci commit podkop
else
  # Новый podkop — оригинальная awk-логика (config section 'main')
  TMP_FILE="/tmp/podkop_tmp"
  awk '
  BEGIN { in_main=0 }
  /^config section '\''main'\''/ { in_main=1; print; next }
  /^config section / && !/^config section '\''main'\''/ { in_main=0 }
  { if (in_main && $1=="list" && $2=="urltest_proxy_links") next; print }
  ' "$CONFIG" > "$TMP_FILE"

  awk -v vless_list="$VLESS_LIST" '
  BEGIN { split(vless_list, arr, "\n"); in_main=0 }
  /^config section '\''main'\''/ { in_main=1 }
  in_main && /^config section / && !/^config section '\''main'\''/ { in_main=0 }
  { print; if (in_main && /^config section / && !/^config section '\''main'\''/) { for (i in arr) if (arr[i] != "") printf "\tlist urltest_proxy_links '\''%s'\''\n", arr[i]; in_main=0 } }
  END { if (in_main) for (i in arr) if (arr[i] != "") printf "\tlist urltest_proxy_links '\''%s'\''\n", arr[i] }
  ' "$TMP_FILE" > "$CONFIG"
  rm -f "$TMP_FILE"
fi

if [ "$COMMAND" = "restart" ]; then restart_target; fi
echo "Серверов: $WRITTEN"
echo "Сервера обновлены"
